# ==============================================================================
# MACRO NEWS INTELLIGENCE & SIGNAL PLATFORM (XAUUSD & JPY PAIRS)
# Environment Configuration Template
# NOTE: Server keys MUST remain strictly on the backend. Never expose to client.
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase (Server Admin - SERVICE ROLE KEY ONLY USED ON SERVER)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI Engine (Anthropic Claude API - Server-side only)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Macro & Economic Data Providers (Optional / Configurable)
FRED_API_KEY=your-st-louis-fred-api-key-here
BLS_API_KEY=your-bureau-of-labor-statistics-api-key-here
FINNHUB_API_KEY=your-finnhub-api-key-here
NEWS_API_KEY=your-news-api-key-here

# Default User & Risk Settings
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_ACCOUNT_BALANCE=10000
DEFAULT_RISK_PER_TRADE_PCT=1.0

# Rate Limiting & Safety
AI_CALL_CACHE_TTL_SECONDS=3600
SIMULATE_DATA_FALLBACK=true
